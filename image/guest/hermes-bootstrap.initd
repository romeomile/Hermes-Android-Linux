#!/sbin/openrc-run
name="Hermes bootstrap"
description="Prepare the agent config, then start the control API, the dashboard and the relay"

depend() {
    need networking
    after networking
}

start() {
    ebegin "Starting Hermes guest services"
    /bootstrap/init_bootstrap.sh
    eend $?
}

stop() {
    ebegin "Stopping Hermes guest services"
    # Stop by pid file, never by process pattern.
    for pidfile in /var/run/hermes-relay.pid /var/run/hermes-dashboard.pid /var/run/control-api.pid; do
        if [ -f "$pidfile" ]; then
            kill "$(cat "$pidfile")" 2>/dev/null
            rm -f "$pidfile"
        fi
    done
    eend $?
}
